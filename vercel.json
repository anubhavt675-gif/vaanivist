{
  "buildCommand": "npm --prefix vaanivisit run build && node -e \"const fs=require('fs');fs.cpSync('vaanivisit/dist','dist',{recursive:true})\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
